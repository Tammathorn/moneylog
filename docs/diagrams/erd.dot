digraph ERD {
  rankdir=LR; fontname="Helvetica"; node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, arrowhead=crow, arrowtail=tee, dir=both, color="#555555"];
  User [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F5F8B"><font color="white"><b>User</b></font></td></tr><tr><td align="left">id PK<br align="left"/>email UNIQUE<br align="left"/>displayName<br align="left"/>role USER|ADMIN<br align="left"/>passwordHash<br align="left"/>isActive<br align="left"/>createdAt<br align="left"/></td></tr></table>>];
  Session [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F5F8B"><font color="white"><b>Session</b></font></td></tr><tr><td align="left">id PK<br align="left"/>tokenHash UNIQUE<br align="left"/>userId FK<br align="left"/>createdAt<br align="left"/>expiresAt<br align="left"/></td></tr></table>>];
  Account [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F5F8B"><font color="white"><b>Account</b></font></td></tr><tr><td align="left">id PK<br align="left"/>userId FK (owner)<br align="left"/>name  UNIQUE(userId,name)<br align="left"/>type CASH|LOAN_GIVEN|LOAN_TAKEN|<br align="left"/>     INCOME|EXPENSE<br align="left"/>subtype WALLET|BANK|CREDIT_CARD|…<br align="left"/>openingBalanceSatang ≥ 0<br align="left"/>openingDate<br align="left"/>isActive<br align="left"/></td></tr></table>>];
  Tx [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F5F8B"><font color="white"><b>MoneyTransaction</b></font></td></tr><tr><td align="left">id PK<br align="left"/>userId FK (owner)<br align="left"/>kind PAYMENT|RECEIPT<br align="left"/>accountId FK (paying/receiving)<br align="left"/>date<br align="left"/>totalSatang &gt; 0<br align="left"/>description<br align="left"/>isFavourite<br align="left"/>createdAt<br align="left"/></td></tr></table>>];
  Line [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F5F8B"><font color="white"><b>TransactionLine</b></font></td></tr><tr><td align="left">id PK<br align="left"/>transactionId FK<br align="left"/>accountId FK<br align="left"/>amountSatang &gt; 0<br align="left"/>note<br align="left"/>UNIQUE(transactionId, accountId)<br align="left"/></td></tr></table>>];
  User -> Session [label="0..*"]; User -> Account [label="owns 0..*"]; User -> Tx [label="owns 0..*"];
  Account -> Tx [label="pays/receives 0..*"]; Tx -> Line [label="1..20"]; Account -> Line [label="allocated 0..*"];
}
