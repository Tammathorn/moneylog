# Copy to server/.env and change the values. Never commit .env.
DATABASE_URL="postgresql://moneylog:moneylog@localhost:5432/moneylog?schema=public"
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SERVE_CLIENT=false
# Password given to every seeded demo account (local only; Secret Manager in GCP)
SEED_DEMO_PASSWORD=change-me-locally
