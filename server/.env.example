# Copy to server/.env for local runs and change every value. Never commit .env.
# On GCP the secret values come from Secret Manager (docs/labs/lab-05/deployment.md).

# PostgreSQL connection (secret in the cloud)
DATABASE_URL="postgresql://moneylog:CHANGE_ME@localhost:5432/moneylog?schema=public"
PORT=3000
NODE_ENV=development
# Allowed Origin for writes besides the app's own origin (local Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# true behind HTTPS (Cloud Run): session cookie gets the Secure flag
COOKIE_SECURE=false
# true in the Docker image: Express also serves client/dist
SERVE_CLIENT=false
# Commit the running build came from; set by the Docker build / deploy pipeline
APP_COMMIT_SHA=local

# --- Seed / migration job only ---
# Password of the first administrator admin@moneylog.test (12+ chars, secret)
ADMIN_PASSWORD=CHANGE_ME_admin_12+
# true = also create demo users alice, bob, dave with sample accounts
SEED_DEMO_DATA=true
# Password of the demo users (12+ chars, secret; required when SEED_DEMO_DATA=true)
DEMO_USER_PASSWORD=CHANGE_ME_demo_12+
